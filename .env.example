ROOT_SUBMITTER_PRIVATE_KEY=0x<64_hex_chars_here>
RELAY_PRIVATE_KEY=0x<64_hex_chars_here>

# Multi-instance overrides (set per instance when running multiple compose projects).
# Host ports must be unique per instance.
POSTGRES_HOST_PORT=5432
INDEXER_HOST_PORT=8080

# Path to the tokens configuration JSON file (relative or absolute path).
# This file will be mounted into the containers.
# Example: ./config/deployed/testnet/tokens.zeth.testnet.json
TOKENS_FILE_PATH=./config/tokens.json
