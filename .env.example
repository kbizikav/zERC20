ROOT_SUBMITTER_PRIVATE_KEY=0x<64_hex_chars_here>
RELAY_PRIVATE_KEY=0x<64_hex_chars_here>

# Multi-instance overrides (set per instance when running multiple compose projects).
# Host ports must be unique per instance.
POSTGRES_HOST_PORT=5432
INDEXER_HOST_PORT=8080

# Optional Base64+gzip payload shared by docker-compose services (same format as
# VITE_TOKENS_COMPRESSED). Generate via scripts/encode_tokens.sh config/tokens.json
# and paste the output below without quotes.
TOKENS_COMPRESSED=
