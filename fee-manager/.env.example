# Path to the shared tokens configuration JSON (see client-common/tokens.rs schema).
TOKENS_FILE_PATH=../config/tokens.json

# Hex-encoded 32-byte private key with FEE_MANAGER_ROLE on each LiquidityManager.
FEE_MANAGER_PRIVATE_KEY=0x0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Interval in seconds between fee parameter updates.
FEE_MANAGER_INTERVAL_SECS=3600

# Incentive coefficient k in basis points (1 = 0.01%, 1000 = 10%).
FEE_MANAGER_K_BPS=1000

# Target liquidity ratio in basis points (8000 = 80%, 10000 = 100%).
# targetLiquidity = (total / chains) * ratio / 10000.
FEE_MANAGER_TARGET_RATIO_BPS=8000

# Set to true to execute the job once and exit (useful for smoke tests).
JOB_ONCE=false
