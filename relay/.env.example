# Port the relay server listens on (default: 3000)
RELAY_PORT=3000

# Private key for signing relay transactions (required, hex string with 0x prefix)
RELAYER_PRIVATE_KEY=0x<64_hex_chars_here>

# Path to tokens configuration file (default: ../config/tokens.json)
TOKENS_FILE_PATH=../config/tokens.json

# RPC URL for Chainlink price oracle queries (Ethereum mainnet).
# Required when tokens.json has no chain 1 entry (e.g. testnet-only configs).
# ORACLE_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/<key>
