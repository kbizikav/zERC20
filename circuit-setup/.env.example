# Circuit Setup Configuration

# Artifact version
ARTIFACTS_VERSION=1.0.0

# Local directory for circuit artifacts
NOVA_ARTIFACTS_DIR=../nova_artifacts

# S3 Configuration (for upload)
S3_BUCKET='zerc20-prod-public-uploads'
S3_PREFIX='circuit-setup'

# Base URL for download (public HTTP/HTTPS)
ARTIFACTS_BASE_URL=https://your-bucket.s3.amazonaws.com/prefix

# Logging level (error, warn, info, debug, trace)
RUST_LOG=info
