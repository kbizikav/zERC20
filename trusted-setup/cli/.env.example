# Optional ptau download URL (defaults to ppot_0080_24).
TRUSTED_SETUP_PTAU_URL=https://pse-trusted-setup-ppot.s3.eu-central-1.amazonaws.com/pot28_0080/ppot_0080_24.ptau

# Optional ptau path (auto-determined from circuit if not set).
TRUSTED_SETUP_PTAU_PATH=

# Coordinator connection.
TRUSTED_SETUP_COORDINATOR_URL=http://localhost:8080
TRUSTED_SETUP_CEREMONY_ID=<ceremony_id>

# Optional seed for deterministic contributions.
TRUSTED_SETUP_SEED=

# Output configuration for finalize.
TRUSTED_SETUP_OUTPUT_DIR=../nova_artifacts
TRUSTED_SETUP_PUBLIC_BASE_URL=https://example.com/trusted-setup

# Timeout settings (in seconds).
TRUSTED_SETUP_CONNECT_TIMEOUT=30
TRUSTED_SETUP_READ_TIMEOUT=300

# State file for resume capability (optional).
TRUSTED_SETUP_STATE_FILE=
