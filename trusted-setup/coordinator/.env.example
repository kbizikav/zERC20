RUST_LOG=warn,trusted_setup_coordinator=info

# HTTP bind address for the coordinator API.
TRUSTED_SETUP_COORDINATOR_ADDR=0.0.0.0:8080

# SQLite database path (defaults to trusted-setup/coordinator/coordinator.sqlite).
TRUSTED_SETUP_SQLITE_PATH=

# S3 storage settings.
TRUSTED_SETUP_S3_BUCKET=<bucket_name>
TRUSTED_SETUP_S3_PREFIX=
TRUSTED_SETUP_S3_PRESIGN_TTL_SECONDS=900

# Lease TTL for in-progress contributions.
TRUSTED_SETUP_LEASE_TTL_SECONDS=7200

# Background cleanup interval for expired leases (in seconds).
TRUSTED_SETUP_CLEANUP_INTERVAL_SECONDS=60

# Rate limiting settings.
TRUSTED_SETUP_RATE_LIMIT_PER_SECOND=10
TRUSTED_SETUP_RATE_LIMIT_BURST=20

# Standard AWS env vars for authentication (if needed by your setup).
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
